{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reader-experience/comments-link",
	"title": "Comments (link)",
	"category": "widgets",
	"icon": "admin-comments",
	"description": "Shows the number of comments and jumps to the comments, the comment form or an anchor of your choice. Meant as a child of the interaction bar.",
	"textdomain": "reader-experience",
	"usesContext": [
		"postId"
	],
	"parent": [
		"reader-experience/interaction-bar"
	],
	"supports": {
		"html": false
	},
	"attributes": {
		"target": {
			"type": "string",
			"default": "auto",
			"enum": [
				"auto",
				"comments",
				"respond",
				"custom"
			]
		},
		"anchor": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"style": [
		"dwp-rx-base"
	]
}
