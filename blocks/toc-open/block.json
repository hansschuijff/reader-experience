{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reader-experience/toc-open",
	"title": "Contents (button)",
	"category": "widgets",
	"icon": "list-view",
	"description": "Button in the interaction bar that opens a panel with the table of contents of the article, built from its headings.",
	"textdomain": "reader-experience",
	"usesContext": [
		"postId"
	],
	"parent": [
		"reader-experience/interaction-bar"
	],
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"style": [
		"rx-base",
		"rx-toc",
		"file:./style-index.css"
	],
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"side": {
			"type": "string",
			"default": "left",
			"enum": [
				"left",
				"right"
			]
		},
		"maxLevel": {
			"type": "number",
			"default": 3
		},
		"minItems": {
			"type": "number",
			"default": 3
		},
		"push": {
			"type": "string",
			"default": "auto",
			"enum": [
				"auto",
				"never"
			]
		},
		"showStats": {
			"type": "boolean",
			"default": false
		},
		"collapseNested": {
			"type": "boolean",
			"default": false
		}
	}
}
