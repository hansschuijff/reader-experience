{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reader-experience/toc",
	"title": "Table of contents",
	"category": "widgets",
	"icon": "list-view",
	"description": "Automatic table of contents from the headings of the article, marking where the visitor is.",
	"textdomain": "reader-experience",
	"usesContext": [ "postId" ],
	"attributes": {
		"title": { "type": "string", "default": "" },
		"maxLevel": { "type": "number", "default": 3 },
		"minItems": { "type": "number", "default": 3 },
		"style": { "type": "string", "default": "standard", "enum": [ "standard", "compact" ] },
		"collapseNested": { "type": "boolean", "default": false },
		"textColor": { "type": "string", "default": "" },
		"backgroundColor": { "type": "string", "default": "" },
		"fontSize": { "type": "number", "default": 0 }
	},
	"supports": {
		"html": false,
		"spacing": { "padding": true, "margin": true }
	},
	"editorScript": "file:./index.js",
	"style": [ "rx-base", "rx-toc", "file:./style-index.css" ],
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
