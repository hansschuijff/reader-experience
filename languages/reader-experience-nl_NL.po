msgstr "Link naar dit artikel"

#: blocks/share/render.php:52
msgid "Copied"
msgstr "Gekopieerd"

#: blocks/share/render.php:54
msgid "Copy"
msgstr "Kopieer"

#. Block description
#: blocks/toc-open/block.json
msgctxt "block description"
msgid ""
"Button in the interaction bar that opens a panel with the table of contents "
"of the article, built from its headings."
msgstr ""
"Knop in de interactiebalk die een paneel opent met de inhoudsopgave van het "
"artikel, opgebouwd uit de koppen."

