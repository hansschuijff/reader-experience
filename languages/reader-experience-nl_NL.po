msgstr "Bedankt voor je duim. Wat kunnen we verbeteren aan deze pagina?"

#: blocks/rating/render.php:65
msgid "Explanation (optional)"
msgstr "Toelichting (optioneel)"

#: blocks/rating/render.php:66
msgid "Optional"
msgstr "Optioneel"

