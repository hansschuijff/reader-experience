#. Block title
#: blocks/comments-link/block.json
msgctxt "block title"
msgid "Comments (link)"
msgstr "Reacties (link)"

#. Block description
#: blocks/comments-link/block.json
msgctxt "block description"
msgid ""
"Shows the number of comments and jumps to the comment form. Meant as a child"
" of the interaction bar."
msgstr ""
"Toont het aantal reacties en springt naar het reactieformulier. Bedoeld als "
"kind van de interactiebalk."

#: blocks/comments-link/index.js:11
msgid "14 comments"
msgstr "14 reacties"

#: blocks/comments-link/render.php:33
msgid "Comments"
msgstr "Reacties"

#. %d: number of comments
#: blocks/comments-link/render.php:39
msgid "%d comment"
msgid_plural "%d comments"
msgstr[0] "%d reactie"
msgstr[1] "%d reacties"

#. Block description
#: blocks/custom-link/block.json
msgctxt "block description"
msgid ""
"A button with an icon in the interaction bar that links to a page, for "
"example a help page. Meant as a child of the interaction bar."
msgstr ""
"Knop met icoon in de interactiebalk die naar een pagina linkt, bijvoorbeeld "
"een uitlegpagina. Bedoeld als kind van de interactiebalk."

#. Block title
#: blocks/custom-link/block.json
