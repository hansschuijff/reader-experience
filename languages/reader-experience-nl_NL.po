msgid "Yes, post it"
msgstr "Ja, plaats het"

#: blocks/rating/render.php:103
msgid "Yes, that is fine"
msgstr "Ja, dat mag"

#: blocks/rating/render.php:109
msgid "Sorry, that did not work. Please try again later."
msgstr "Sorry, dat is niet gelukt. Probeer het later opnieuw."

#: blocks/rating/render.php:113
