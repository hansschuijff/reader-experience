<?xml version="1.0"?>
<ruleset name="Reader Experience code standards">
	<description>WordPress Core and Docs standards, with PSR-4 class files (no "class-" prefix) and snake_case code.</description>

	<!-- What to check. -->
	<file>reader-experience.php</file>
	<file>uninstall.php</file>
	<file>src/</file>
	<file>blocks/</file>

	<!-- Third-party and generated code. -->
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>

	<!-- Class files are named after the class (PSR-4 / Composer autoloading), without "class-" prefix. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<!-- Text domain of the plugin. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="reader-experience"/>
			</property>
		</properties>
	</rule>

	<!-- Everything global is prefixed. The namespace covers classes; hooks use "reader_experience/". -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ReaderExperience"/>
				<element value="reader_experience"/>
			</property>
		</properties>
	</rule>

	<!-- Hook names are namespaced with a slash: "reader_experience/heading_anchors_enabled". -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<!-- Block render templates get $attributes, $content and $block from WordPress. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>blocks/*/render.php</exclude-pattern>
	</rule>
</ruleset>
